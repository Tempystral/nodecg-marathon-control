{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "started": {
            "type": "boolean",
            "default": false
        },
        "completed": {
            "type": "boolean",
            "default": false
        },
        "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "verifyStream": {
                    "type": "boolean",
                    "default": false
                },
                "checkAudio": {
                    "type": "boolean",
                    "default": false
                },
                "checkInfo": {
                    "type": "boolean",
                    "default": false
                },
                "checkReady": {
                    "type": "boolean",
                    "default": false
                },
                "finalCheck": {
                    "type": "boolean",
                    "default": false
                }
            },
            "required": [
                "verifyStream",
                "checkAudio",
                "checkInfo",
                "checkReady",
                "finalCheck"
            ]
        }
    },
    "required": [
        "items",
        "completed",
        "started"
    ]
}