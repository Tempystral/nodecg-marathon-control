{
  "name": "nodecg-marathon-control",
  "version": "2.0.0",
  "description": "A NodeCG bundle to control all aspects of a marathon's stream.",
  "homepage": "https://github.com/nicnacnic/nodecg-marathon-control",
  "license": "MIT",
  "author": "nicnacnic",
  "scripts": {
    "autofix": "run-s autofix:*",
    "autofix:browser": "eslint --fix --ext .ts,.vue src/dashboard && eslint --fix --ext .ts,.vue src/graphics",
    "autofix:extension": "eslint --fix --ext .ts src/extension && eslint --fix --ext .d.ts src/types",
    "build": "run-s clean build:*",
    "build:browser": "vite build",
    "build:extension": "tsc -b tsconfig.extension.json",
    "clean": "rm -rf node_modules/.cache extension dashboard graphics",
    "schema-types": "nodecg schema-types",
    "start": "nodecg start",
    "watch": "run-p watch:*",
    "watch:browser": "vite",
    "watch:extension": "tsc -b tsconfig.extension.json -w"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "@primeuix/themes": "^1.0.3",
    "@types/ws": "^8.18.1",
    "@vueuse/head": "^2.0.0",
    "audio-mixer": "^2.1.4",
    "discord.js": "^14.18.0",
    "node-fetch": "3.3.2",
    "nodecg": "^2.5.3",
    "nodecg-vue-composable": "~/git/nodecg-vue-composable",
    "obs-websocket-js": "^5.0.6",
    "primevue": "^4.3.3",
    "prism-media": "^1.3.5",
    "set-interval-async": "^3.0.3",
    "speedcontrol-util": "^0.6.1",
    "vite": "^6.3.3",
    "vue": "^3.5.13",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@nodecg/types": "^2.5.3",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.24.0",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import-x": "^4.10.5",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "module-alias": "^2.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.87.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite-plugin-checker": "^0.9.1",
    "vite-plugin-nodecg": "^2.1.0",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@discordjs/opus",
      "@vaadin/vaadin-usage-statistics",
      "better-sqlite3",
      "esbuild",
      "iframe-resizer",
      "vue-demi"
    ]
  },
  "nodecg": {
    "compatibleRange": "^2.1.11",
    "bundleDependencies": {
      "nodecg-speedcontrol": "^2.4.0",
      "nodecg-components": "^1.0.0"
    },
    "assetCategories": [
      {
        "name": "camCover",
        "title": "Cam Cover",
        "allowedTypes": [
          "jpg",
          "jpeg",
          "gif",
          "png"
        ]
      }
    ],
    "dashboardPanels": [
      {
        "name": "stats",
        "title": "Stats",
        "width": 3,
        "file": "stats.html"
      },
      {
        "name": "obsSettings",
        "title": "General",
        "width": 3,
        "file": "obsSettings.html",
        "workspace": "Settings"
      }
    ]
  }
}